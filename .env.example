# Add your key after copying this file to .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# Set to 1 only for non-interactive environments. Headed Chromium is more
# likely to pass Cloudflare and lets you complete a challenge if prompted.
VINGROUP_BROWSER_HEADLESS=0
# Prefer the locally installed stable browser; set to chromium to use the
# Playwright-managed browser instead.
VINGROUP_BROWSER_CHANNEL=chrome
# VINGROUP_BROWSER_PROFILE=.vingroup-browser-profile
