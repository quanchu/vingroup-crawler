# Add your key after copying this file to .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# Optional provider defaults for the analyze command.
LLM_PROVIDER=openai
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Native Ollama (server must already be running).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# Generic local OpenAI-compatible server such as LM Studio or vLLM.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_OPENAI_API_KEY=local
# LOCAL_OPENAI_MODEL=
LOCAL_LLM_TIMEOUT=300
# The Cloudflare fallback runs unattended in a headless browser.
# Options: chromium (bundled), chrome, or default (current macOS default browser).
# VINGROUP_BROWSER_CHANNEL=default
# VINGROUP_BROWSER_PROFILE=.vingroup-browser-profile
